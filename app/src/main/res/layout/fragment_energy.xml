<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Energy Habits"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/txtProgressPercentage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="0%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">
        <CheckBox
            android:id="@+id/cbHabit1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unplug standby appliances"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#3E2723"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">
        <CheckBox
            android:id="@+id/cbHabit2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn off AC/Fan when leaving"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#3E2723"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">
        <CheckBox
            android:id="@+id/cbHabit3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unplug laptop/phone charger"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#3E2723"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">
        <CheckBox
            android:id="@+id/cbHabit4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn off lights during the day"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#3E2723"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">
        <CheckBox
            android:id="@+id/cbHabit5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use reusable water bottle"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#3E2723"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSaveEnergy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#4CAF50"
        android:text="Save Habits"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="12dp"/>

</LinearLayout>